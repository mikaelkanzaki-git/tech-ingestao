# Contrato local compartilhado com o tech-ai.
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIMENSIONS=384

# Modo padrão: servidor Chroma executado localmente.
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=medquad_knowledge_minilm_v1

# Para usar o Chroma Cloud, troque as quatro variáveis de conexão acima e
# configure as credenciais abaixo. Nunca versione o arquivo .env real.
# CHROMA_MODE=cloud
# CHROMA_HOST=api.trychroma.com
# CHROMA_PORT=443
# CHROMA_SSL=true
# CHROMA_API_KEY=chroma_key_...
# CHROMA_TENANT=seu-tenant-id
# CHROMA_DATABASE=seu-database
